# App
APP_ENV=dev
APP_DEBUG=true
APP_URL=https://slimtds.local
APP_SECRET=CHANGE_ME_32_bytes_random_string
APP_TZ=Europe/Moscow

# Deploy mode (dev|cf_flex|cf_full|direct)
DEPLOY_MODE=dev
DOMAIN=slimtds.local

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=slimtds
DB_USER=slimtds
DB_PASSWORD=slimtds
DB_DSN=pgsql:host=${DB_HOST};port=${DB_PORT};dbname=${DB_NAME}

# Admin bootstrap (применяется ТОЛЬКО при первом запуске `bin/console admin:init`)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Session
SESSION_NAME=slimtds_sess
SESSION_LIFETIME=1209600
# Anonymous login/CSRF sessions do not need the 14-day authenticated lifetime.
SESSION_ANONYMOUS_LIFETIME=3600

# FrankenPHP
FRANKENPHP_WORKER_MODE=1
# FRANKENPHP_NUM_THREADS — removed: FrankenPHP defaults to CPU-core count

# Rate-limit (минутные окна)
RATE_LIMIT_IP=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_COOKIE=20

# MaxMind (используется в M2)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Cloudflare (prod-cf)
# UNUSED: nothing reads this key. The real client IP comes from
# config/frankenphp/Caddyfile.cf (static list of Cloudflare ranges +
# client_ip_headers CF-Connecting-IP) and src/Shared/RealIp.php. Leave it empty.
TRUSTED_PROXIES=

# Telegram (используется в M3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional partner-wide incoming postbacks. Keep real tokens only in the
# server env file; each token must be at least 32 characters. Offer hosts are
# exact destination hosts allowed for that partner network.
# Optional per-network fallback campaign preserves authenticated money events
# whose partner subid cannot be mapped to a retained/imported click.
NETWORK_POSTBACKS={}

# Optional FX rates for non-USD postback payouts: JSON map of currency →
# units per 1 USD. When an offer's currency is listed here, its postback
# payout is converted to USD at ingest (stats stay single-currency) and the
# Telegram notification shows the native amount plus the USD equivalent.
# Without a rate the native amount is stored with the offer's own currency.
POSTBACK_FX_RATES={}

# --- Demo instance (Part 2) — ONLY set these on the dedicated demo VPS, NEVER on prod ---
# DEMO_MODE=1 enables demo:reset (full wipe + reseed every 4h). Absent everywhere else.
DEMO_MODE=
# Public hostname for the demo (used by direct-mode Caddy for Let's Encrypt TLS).
DEMO_DOMAIN=
