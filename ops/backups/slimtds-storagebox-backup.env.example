HETZNER_STORAGEBOX_HOST=u000000.your-storagebox.de
HETZNER_STORAGEBOX_USER=u000000
HETZNER_STORAGEBOX_PORT=23
HETZNER_STORAGEBOX_SSH_KEY_PATH=/root/.ssh/storagebox_slimtds
HETZNER_STORAGEBOX_KNOWN_HOSTS=/root/.ssh/known_hosts_storagebox
SLIMTDS_STORAGEBOX_REMOTE_PATH=affscale/slimtds/affvibes.com/database
SLIMTDS_STORAGEBOX_KEEP=30
SLIMTDS_BACKUP_SOURCE_DIR=/opt/slimtds/var/backups
SLIMTDS_GPG_HOMEDIR=/root/.gnupg-slimtds-backup
SLIMTDS_GPG_RECIPIENT=replace-with-public-key-fingerprint
